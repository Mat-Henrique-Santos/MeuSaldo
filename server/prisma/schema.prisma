generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Category {
  FOOD
  TRANSPORT
  FUN
  BILLS
  SALARY
  SHOPPING
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  category    Category
  amount      Decimal
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  target    Decimal
  saved     Decimal  @default(0)
  deadline  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
